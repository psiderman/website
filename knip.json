{
  "compilers": {
    "svg": ""
  },
  "entry": ["index.html", "api/**/*.ts", "src/fonts.css", "src/main.ts", "scripts/**/*.js"],
  "ignore": ["src/components/PsiderLogo.vue"],
  "ignoreBinaries": ["vercel"],
  "ignoreDependencies": [
    "@fontsource-variable/bricolage-grotesque",
    "@fontsource/source-serif-pro",
    "@fontsource/kalam",
    "vue-tippy"
  ],
  "project": [
    "src/**/*.{css,gif,jpeg,jpg,mp4,png,svg,ts,vue,webp,woff,woff2}",
    "api/**/*.ts",
    "scripts/**/*.js"
  ]
}
