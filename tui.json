{
  "$schema": "https://opencode.ai/tui.json",
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "sound_pack": "opencode.default",
    "volume": 0.4
  },
  "cursor": {
    "blinking": true,
    "style": "line"
  },
  "diff_style": "auto",
  "keybinds": {
    "command_list": "ctrl+p",
    "leader": "ctrl+x"
  },
  "leader_timeout": 2000,
  "mouse": true,
  "scroll_acceleration": {
    "enabled": false
  },
  "scroll_speed": 3,
  "theme": "opencode"
}
